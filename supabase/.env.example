# DigiReps Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────
# HOW TO USE:
#   Local dev:   Copy this to backend/.env and fill in the values
#   Railway:     Add these as Environment Variables in Railway dashboard
# ─────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
# REQUIRED — the app will refuse to start without these two.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPPORT_ADMIN_SECRET=your-support-access-key

# ── Server ───────────────────────────────────────────────────────
# Railway sets PORT automatically — don't change this line
PORT=3001

# ── URLs (update these after deployment) ─────────────────────────
# The deployed URL of your admin portal (e.g. https://admin.digireps.app)
# Used in invite emails and CORS allowlist
ADMIN_PORTAL_URL=http://localhost:5174

# The deployed URL of your public landing page (e.g. https://digireps.app)
# Used in CORS allowlist
LANDING_URL=http://localhost:3000

# ── Email (Resend) ────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourapp.com

# ── Stripe Billing ───────────────────────────────────────────────
# Get from: https://dashboard.stripe.com → Developers → API Keys
# STRIPE_SECRET_KEY — server-side only, NEVER expose client-side
STRIPE_SECRET_KEY=sk_live_your_secret_key
# STRIPE_WEBHOOK_SECRET — from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs — get from: Stripe Dashboard → Products
# Create one product per plan/period combination and copy the Price ID here
STRIPE_PRICE_BASIC_MONTHLY=price_xxxxx
STRIPE_PRICE_BASIC_YEARLY=price_xxxxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxxx