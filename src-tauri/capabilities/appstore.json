{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "appstore",
  "description": "Capability for the Mac App Store build — updater permissions intentionally excluded (Apple Guideline 2.4.5 vii).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "dialog:default",
    "process:default",
    "process:allow-restart"
  ]
}
